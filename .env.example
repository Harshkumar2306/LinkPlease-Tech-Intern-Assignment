# LinkPlease configuration
# Copy to .env and fill in, OR set these as real environment variables.

# Required: your Pseudogram API key from POST /v1/keygen.
# The key you deploy with MUST match the key you submit with.
PSEUDOGRAM_API_KEY=

# Optional overrides (defaults shown).
# PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
# DATABASE_PATH=linkplease.db
# VERIFY_SIGNATURES=true
# RATE_LIMIT_PER_MINUTE=9
# MAX_ATTEMPTS=5
# MAX_SEND_RETRIES=20
# MAX_RECONCILE_RETRIES=10
# RECONCILE_INTERVAL=3.0
# DISPATCH_INTERVAL=0.1
# HTTP_TIMEOUT=15.0
